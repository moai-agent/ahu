/target/
/.worktrees/
/security-reviews/
/fixes/

# Vale downloads style packages into .vale/styles; only the project
# vocabulary under .vale/styles/config/ is tracked.
/.vale/styles/*
!/.vale/styles/config/

# Local secrets and environment overrides. Keep checked-in examples explicit.
.env
.env.*
!.env.example
!.env.template
