/target/
/.worktrees/
/security-reviews/
/fixes/

# Keep the repository skill copy visible even with a global .claude/ ignore.
!/.claude/
/.claude/*
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/discover-requirements/

# Vale downloads style packages into .vale/styles; only the project
# vocabulary under .vale/styles/config/ is tracked.
/.vale/styles/*
!/.vale/styles/config/
