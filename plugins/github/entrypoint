#!/usr/bin/env python3
"""Optional GitHub issue inspection (V2) and legacy offline simulation (V1)."""

import hashlib
import json
import os
import re
import selectors
import stat
import subprocess
import time
import sys

EXPECTED_KEYS = {"protocol_version", "plugin_id", "grant", "context", "input"}
INPUT_KEYS = {"version", "action", "operation_id", "issue", "tracker_visibility", "scopes", "expected_revision", "state", "body"}
ISSUE_KEYS = {"project", "number", "visibility"}
STATE_KEYS = {"revision", "applied"}


def fail():
    response = {"protocol_version": 1, "status": "error", "code": "invalid_input"}
    sys.stdout.write(json.dumps(response))
    sys.stdout.flush()
    sys.exit(0)


def text(value, limit):
    if isinstance(value, str) and 1 <= len(value) <= limit:
        return value
    fail()


def whole(value, minimum):
    if isinstance(value, int) and not isinstance(value, bool) and value >= minimum:
        return value
    fail()


def digest(action, issue, body):
    payload = json.dumps({"action": action, "body": body, "issue": issue}, sort_keys=True)
    return hashlib.sha256(payload.encode()).hexdigest()


def main():
    if sys.argv[1:] != ["--ahu-plugin-protocol=1"]:
        fail()
    try:
        raw = sys.stdin.buffer.read(65537)
        if len(raw) > 65536:
            fail()
        request = json.loads(raw, object_pairs_hook=unique_object)
    except (ValueError, UnicodeDecodeError, RecursionError):
        fail()
    if not isinstance(request, dict) or set(request) != EXPECTED_KEYS:
        fail()
    if type(request["protocol_version"]) is not int or request["protocol_version"] != 1:
        fail()
    if request["plugin_id"] != "github":
        fail()
    if request["grant"] != {"operation": "invoke"}:
        fail()
    if not isinstance(request["context"], dict):
        fail()
    data = request["input"]
    if isinstance(data, dict) and type(data.get("version")) is int and data["version"] == 2:
        inspect_issue(data)
        return
    if not isinstance(data, dict) or set(data) != INPUT_KEYS:
        fail()
    if type(data["version"]) is not int or data["version"] != 1:
        fail()
    if data["action"] not in ("comment", "close"):
        fail()
    operation_id = text(data["operation_id"], 128)
    issue = data["issue"]
    if not isinstance(issue, dict) or set(issue) != ISSUE_KEYS:
        fail()
    project = text(issue["project"], 64)
    number = whole(issue["number"], 1)
    if issue["visibility"] not in ("public", "private"):
        fail()
    if data["tracker_visibility"] not in ("public", "private"):
        fail()
    scopes = data["scopes"]
    if not isinstance(scopes, list) or any(
        not isinstance(scope, str) or not 1 <= len(scope) <= 64 for scope in scopes
    ):
        fail()
    expected_revision = whole(data["expected_revision"], 0)
    state = data["state"]
    if not isinstance(state, dict) or set(state) != STATE_KEYS:
        fail()
    revision = whole(state["revision"], 0)
    applied = state["applied"]
    if not isinstance(applied, dict) or any(
        not isinstance(key, str)
        or not 1 <= len(key) <= 128
        or not isinstance(value, str)
        or not 1 <= len(value) <= 128
        for key, value in applied.items()
    ):
        fail()
    body = data["body"]
    if data["action"] == "comment":
        if not isinstance(body, str) or not 1 <= len(body) <= 16384:
            fail()
    elif body is not None:
        fail()
    operation_digest = digest(data["action"], issue, body)
    outcome = "applied"
    reason = None
    reference = {"issue": number, "project": project}
    # A receipt is evidence of a previous action, never current authority.
    if "issues:write" not in scopes:
        outcome = "refused"
        reason = "missing-scope"
        reference = None
    elif data["tracker_visibility"] == "private" and issue["visibility"] == "public":
        outcome = "refused"
        reason = "visibility-mismatch"
        reference = None
    elif applied.get(operation_id) == operation_digest:
        outcome = "idempotent"
    elif operation_id in applied:
        outcome = "refused"
        reason = "duplicate-ambiguous"
        reference = None
    elif expected_revision != revision:
        outcome = "refused"
        reason = "stale-revision"
        reference = None
    else:
        recorded = dict(applied)
        recorded[operation_id] = operation_digest
        state = {"revision": revision + 1, "applied": recorded}
    result = {
        "version": 1,
        "provider": "github",
        "operation_id": operation_id,
        "outcome": outcome,
        "reason": reason,
        "reference": reference,
        "state": state,
    }
    response = {"status": "ok", "protocol_version": 1, "result": result}
    sys.stdout.write(json.dumps(response))
    sys.stdout.flush()



class InspectionError(Exception):
    """Only fixed codes cross the provider boundary."""


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        if key in result:
            raise ValueError()
        result[key] = value
    return result


def repository_name(value):
    return (isinstance(value, str) and len(value) <= 140
            and re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9-]{0,38}/[A-Za-z0-9_.-]{1,100}", value)
            and value.split("/")[1] not in (".", ".."))


def gh_executable():
    # Never resolve relative PATH entries or executables inside a Git checkout.
    for directory in os.environ.get("AHU_GITHUB_PATH", "").split(os.pathsep):
        if not os.path.isabs(directory):
            continue
        candidate = os.path.realpath(os.path.join(directory, "gh"))
        try:
            mode = os.stat(candidate).st_mode
            if not stat.S_ISREG(mode) or mode & (stat.S_ISUID | stat.S_ISGID):
                continue
            if not os.access(candidate, os.X_OK):
                continue
            parent = os.path.dirname(candidate)
            while parent != os.path.dirname(parent):
                if os.path.lexists(os.path.join(parent, ".git")):
                    break
                parent = os.path.dirname(parent)
            else:
                return candidate
        except OSError:
            continue
    raise InspectionError("gh_unavailable")


def gh_json(executable, endpoint, projection):
    # No shell, no repo inference, no user-selected host, query or method.
    environment = {key: os.environ[key] for key in
                   ("HOME", "XDG_CONFIG_HOME", "GH_CONFIG_DIR", "GH_TOKEN", "GITHUB_TOKEN")
                   if key in os.environ}
    environment.update(PATH="/usr/bin:/bin", GH_PROMPT_DISABLED="1", GH_PAGER="cat")
    try:
        child = subprocess.Popen(
            [executable, "api", "--hostname", "github.com", "--method", "GET",
             endpoint, "--jq", projection], env=environment,
            stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    except OSError:
        raise InspectionError("gh_unavailable") from None
    try:
        deadline = time.monotonic() + 2
        output = bytearray()
        with selectors.DefaultSelector() as selector:
            selector.register(child.stdout, selectors.EVENT_READ)
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0 or not selector.select(remaining):
                    raise InspectionError("provider_timeout")
                chunk = os.read(child.stdout.fileno(), 4096)
                if not chunk:
                    break
                output.extend(chunk)
                if len(output) > 65536:
                    raise InspectionError("provider_output_limit")
        try:
            status = child.wait(timeout=max(0, deadline - time.monotonic()))
        except subprocess.TimeoutExpired:
            raise InspectionError("provider_timeout") from None
        if status != 0:
            raise InspectionError("provider_failed")
        try:
            value = json.loads(output, object_pairs_hook=unique_object)
        except (ValueError, UnicodeDecodeError, RecursionError):
            raise InspectionError("provider_malformed") from None
        if not isinstance(value, dict):
            raise InspectionError("provider_malformed")
        return value
    except OSError:
        raise InspectionError("provider_failed") from None
    finally:
        if child.poll() is None:
            child.kill()
        child.wait()
        child.stdout.close()


def inspect_issue(data):
    result = {"version": 2, "provider": "github", "outcome": "error",
              "code": None, "reference": None, "state": None}
    try:
        if (set(data) != {"version", "action", "repository", "issue_number", "expected_visibility"}
                or data["action"] != "inspect"
                or not repository_name(data["repository"])
                or type(data["issue_number"]) is not int
                or not 1 <= data["issue_number"] <= 2147483647
                or data["expected_visibility"] not in ("public", "private")):
            raise InspectionError("invalid_input")
        if os.environ.get("AHU_GITHUB_CLI") != "1":
            raise InspectionError("github_cli_denied")
        executable = gh_executable()
        repository = data["repository"]
        repo = gh_json(executable, "repos/" + repository,
                       "{full_name, html_url, private, visibility}")
        if (set(repo) != {"full_name", "html_url", "private", "visibility"}
                or not repository_name(repo["full_name"])
                or type(repo["private"]) is not bool
                or repo["visibility"] not in ("public", "private")
                or not isinstance(repo["html_url"], str)):
            raise InspectionError("provider_malformed")
        canonical = repo["full_name"]
        if (canonical.lower() != repository.lower()
                or repo["html_url"] != "https://github.com/" + canonical):
            raise InspectionError("repository_mismatch")
        if (repo["visibility"] != data["expected_visibility"]
                or repo["private"] != (repo["visibility"] == "private")):
            raise InspectionError("visibility_mismatch")
        number = data["issue_number"]
        issue = gh_json(executable, "repos/" + canonical + "/issues/" + str(number),
                        '{number, html_url, repository_url, state, is_pull_request: has("pull_request")}')
        if (set(issue) != {"number", "html_url", "repository_url", "state", "is_pull_request"}
                or type(issue["number"]) is not int
                or type(issue["is_pull_request"]) is not bool
                or issue["state"] not in ("open", "closed")
                or not isinstance(issue["html_url"], str)
                or not isinstance(issue["repository_url"], str)):
            raise InspectionError("provider_malformed")
        reference = "https://github.com/" + canonical + "/issues/" + str(number)
        if (issue["number"] != number or issue["html_url"] != reference
                or issue["repository_url"] != "https://api.github.com/repos/" + canonical
                or issue["is_pull_request"]):
            raise InspectionError("issue_mismatch")
        result.update(outcome="read", reference={"repository": canonical,
                      "issue_number": number, "url": reference},
                      state={"visibility": repo["visibility"], "status": issue["state"]})
    except InspectionError as error:
        result["code"] = str(error)
    sys.stdout.write(json.dumps({"status": "ok", "protocol_version": 1, "result": result}))
    sys.stdout.flush()


main()
